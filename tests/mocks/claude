#!/usr/bin/env bash
# Mock `claude` CLI used by the claude-grammar test suite.
# Behavior is driven entirely by the input on stdin (the <text>...</text>
# block). We intentionally ignore --system-prompt and --model so the tests
# stay decoupled from those flags.
#
# Recognized triggers (checked in order, first match wins):
#
#   __FORCE_NO_ERRORS__   -> NO_ERRORS
#   __FORCE_GARBAGE__     -> garbage that should fail the format filter
#   __FORCE_TOO_MANY__    -> 5 suggestions; only first 3 should survive
#
#   "i has" / "he go"     -> A1 subject-verb-agreement suggestions
#   "explain me"          -> B2 verb-pattern suggestion
#
# Anything else with no match returns NO_ERRORS.

set -u

input=$(cat)

if [[ "$input" == *"__FORCE_NO_ERRORS__"* ]]; then
  printf 'NO_ERRORS\n'
  exit 0
fi

if [[ "$input" == *"__FORCE_GARBAGE__"* ]]; then
  printf 'Sorry, I cannot help with that.\nHere are some thoughts:\n* bullet point\n'
  exit 0
fi

if [[ "$input" == *"__FORCE_TOO_MANY__"* ]]; then
  cat <<'EOF'
"a" -> "b"
"c" -> "d"
"e" -> "f"
"g" -> "h"
"i" -> "j"
EOF
  exit 0
fi

# Heuristic matching against the kind of errors the real LLM would return.
# Cap output at 3 lines to mirror the system prompt's "up to 3" contract.
emitted=0
emit() {
  [[ $emitted -ge 3 ]] && return
  printf '%s\n' "$1"
  emitted=$((emitted + 1))
}

[[ "$input" == *"i has"*      ]] && emit '"i has" -> "I have"'
[[ "$input" == *"he go"*      ]] && emit '"he go" -> "he goes"'
[[ "$input" == *"explain me"* ]] && emit '"explain me" -> "explain to me"'

[[ $emitted -eq 0 ]] && printf 'NO_ERRORS\n'
exit 0
